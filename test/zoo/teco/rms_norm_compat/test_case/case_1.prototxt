op_name: "rms_norm_compat"

input {
  id: "input"
  shape: {
    dims: 32
    dims: 4096
  }
  layout: LAYOUT_NCHW
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data: {
    seed: 45
    upper_bound: 1.0
    lower_bound: -1.0
    distribution: UNIFORM
  }
}

input {
  id: "weight"
  shape: {
    dims: 4096
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data: {
    seed: 46
    upper_bound: 1.0
    lower_bound: -1.0
    distribution: UNIFORM
  }
}

input {
  id: "rstd"
  shape: {
    dims: 32
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  ttype: TENSOR
  random_data: {
    seed: 47
    upper_bound: 2.0
    lower_bound: 0.25
    distribution: UNIFORM
  }
}

input {
  id: "residual"
  shape: {
    dims: 32
    dims: 4096
  }
  layout: LAYOUT_NCHW
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data: {
    seed: 48
    upper_bound: 1.0
    lower_bound: -1.0
    distribution: UNIFORM
  }
}

output {
  id: "output"
  shape: {
    dims: 32
    dims: 4096
  }
  layout: LAYOUT_NCHW
  dtype: DTYPE_HALF
  ttype: TENSOR
}

output {
  id: "residual_out"
  shape: {
    dims: 32
    dims: 4096
  }
  layout: LAYOUT_NCHW
  dtype: DTYPE_HALF
  ttype: TENSOR
}
