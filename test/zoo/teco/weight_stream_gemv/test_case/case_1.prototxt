op_name: "weight_stream_gemv"

input {
  id: "x"
  shape { dims: 512 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data {
    seed: 51
    lower_bound: -0.25
    upper_bound: 0.25
    distribution: UNIFORM
  }
}

input {
  id: "weight"
  shape { dims: 512 dims: 512 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data {
    seed: 52
    lower_bound: -0.25
    upper_bound: 0.25
    distribution: UNIFORM
  }
}

output {
  id: "output"
  shape { dims: 512 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
}

test_param {
  error_func: DIFF1
  error_threshold: 1e-2
}
