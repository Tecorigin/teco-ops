op_name: "ms_deform_attn_forward"

input {
  id: "value"
  shape { dims: 1 dims: 6 dims: 2 dims: 32 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data { seed: 1 lower_bound: -1.0 upper_bound: 1.0 distribution: UNIFORM }
}
input {
  id: "spatial_shapes"
  shape { dims: 2 dims: 2 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  ttype: TENSOR
  prev_value { value_l: 2 value_l: 2 value_l: 1 value_l: 2 }
}
input {
  id: "sampling_locations"
  shape { dims: 1 dims: 2 dims: 2 dims: 2 dims: 2 dims: 2 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data { seed: 2 lower_bound: 0.0 upper_bound: 1.0 distribution: UNIFORM }
}
input {
  id: "attention_weights"
  shape { dims: 1 dims: 2 dims: 2 dims: 2 dims: 2 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data { seed: 3 lower_bound: 0.0 upper_bound: 1.0 distribution: UNIFORM }
}

output {
  id: "output"
  shape { dims: 1 dims: 2 dims: 64 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
}

tecokernel_param: {
  ms_deform_attn_forward_param: {}
}

# FP16 boundary case: the CPU oracle computes in FP32 and the fixture compares the
# FP16 device output, so the gate matches the FP16 limit used by
# python_api_test/test_ms_deform_attn_forward.py (2e-3), not the FP32 5e-5.
test_param: {
  error_func: DIFF1
  error_threshold: 2e-3
}

