op_name: "ms_deform_attn_backward"

input {
  id: "value"
  shape { dims: 1 dims: 6 dims: 1 dims: 4 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  ttype: TENSOR
  random_data { seed: 1 lower_bound: -1 upper_bound: 1 distribution: UNIFORM }
}
input {
  id: "spatial_shapes"
  shape { dims: 1 dims: 2 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  ttype: TENSOR
  prev_value { value_l: 2 value_l: 3 }
}
input {
  id: "sampling_locations"
  shape { dims: 1 dims: 2 dims: 1 dims: 1 dims: 2 dims: 2 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  ttype: TENSOR
  prev_value { value_f: 0.25 value_f: 0.375 value_f: 0.25 value_f: 0.375 value_f: 0.25 value_f: 0.375 value_f: 0.25 value_f: 0.375 }
}
input {
  id: "attention_weights"
  shape { dims: 1 dims: 2 dims: 1 dims: 1 dims: 2 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  ttype: TENSOR
  random_data { seed: 3 lower_bound: 0.2 upper_bound: 0.8 distribution: UNIFORM }
}
input {
  id: "grad_output"
  shape { dims: 1 dims: 2 dims: 4 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  ttype: TENSOR
  random_data { seed: 4 lower_bound: -1 upper_bound: 1 distribution: UNIFORM }
}
output {
  id: "grad_value"
  shape { dims: 1 dims: 6 dims: 1 dims: 4 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  ttype: TENSOR

}
output {
  id: "grad_locations"
  shape { dims: 1 dims: 2 dims: 1 dims: 1 dims: 2 dims: 2 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  ttype: TENSOR

}
output {
  id: "grad_weights"
  shape { dims: 1 dims: 2 dims: 1 dims: 1 dims: 2 }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  ttype: TENSOR

}

tecokernel_param { ms_deform_attn_backward_param {} }
test_param { error_func: DIFF1 error_threshold: 5e-5 }

