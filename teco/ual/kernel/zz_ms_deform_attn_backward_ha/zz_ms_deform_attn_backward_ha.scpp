#include "ual/kernel/zz_ms_deform_attn_backward_ha/zz_ms_deform_attn_backward_ha.h"
#include <cmath>
#include <cstdint>
#include "sdaa_atomic.h"
#include <sdaa_memcpy.h>
#include "teco_kernel_context.h"

namespace {

__device__ inline float load_scalar(const float *ptr, size_t index) {
    return ptr[index];
}
__device__ inline float load_scalar(const half *ptr, size_t index) {
    const std::uint16_t bits = reinterpret_cast<const std::uint16_t *>(ptr)[index];
    if ((bits & 0x7c00u) == 0) {
        const float magnitude = static_cast<float>(bits & 0x03ffu) * 0x1p-24f;
        return (bits & 0x8000u) ? -magnitude : magnitude;
    }
    return static_cast<float>(ptr[index]);
}
__device__ inline void store_scalar(float *ptr, size_t index, float value) {
    ptr[index] = value;
}
__device__ inline void store_scalar(half *ptr, size_t index, float value) {
    const std::uint32_t bits = *reinterpret_cast<const std::uint32_t *>(&value);
    const unsigned exponent = (bits >> 23) & 0xffu;
    if (exponent <= 112u) {
        const std::uint16_t sign = static_cast<std::uint16_t>((bits >> 16) & 0x8000u);
        unsigned rounded = 0;
        if (exponent >= 102u) {
            const unsigned mantissa = (bits & 0x007fffffu) | 0x00800000u;
            const unsigned shift = 126u - exponent;
            rounded = mantissa >> shift;
            const unsigned remainder = mantissa & ((1u << shift) - 1u);
            const unsigned midpoint = 1u << (shift - 1u);
            if (remainder > midpoint || (remainder == midpoint && (rounded & 1u))) {
                ++rounded;
            }
        }
        reinterpret_cast<std::uint16_t *>(ptr)[index] = sign | rounded;
    } else {
        ptr[index] = static_cast<half>(value);
    }
}

template <typename T>
__device__ void bilinear_backward_gather(MsDeformAttnBackwardArgs args) {
    const T *value = static_cast<const T *>(args.value);
    const T *locations = static_cast<const T *>(args.sampling_locations);
    const T *weights = static_cast<const T *>(args.attention_weights);
    const T *grad_output = static_cast<const T *>(args.grad_output);
    T *grad_locations = static_cast<T *>(args.grad_locations);
    T *grad_weights = static_cast<T *>(args.grad_weights);
    const int heads = args.num_heads;
    const int dims = args.head_dim;
    const int queries = args.num_queries;
    const int levels = args.num_levels;
    const int points = args.num_points;
    const size_t samples_per_owner = static_cast<size_t>(levels) * points;
    const size_t owners = static_cast<size_t>(args.batch) * queries * heads;
    const size_t samples = owners * samples_per_owner;
    const size_t outputs =
        static_cast<size_t>(args.batch) * args.value_len * heads * dims;
    const size_t leaves =
        static_cast<size_t>(args.batch) * args.value_len * heads;

    // Stage 1 - one work item per value leaf (pixel, head).  The per-sampling-
    // point geometry and the attention weight are derived once per leaf instead
    // of once per (leaf, dim), so a leaf's grad_value elements share one scan;
    // that scan owns 480 of the 568 lane memory operations on the official
    // scored shape, and four fifths of them were redundant across the dim axis.
    //
    // Each leaf accumulates its elements in registers, four dim lanes at a
    // time, with a scalar tail for head_dim % 4 != 0.  The contribution
    // expression, its association and the per-element summation order are
    // unchanged, so grad_value stays bit-identical; every element is still
    // written here, which is what keeps the reset launch redundant.
    for (size_t leaf = static_cast<size_t>(threadIdx); leaf < leaves;
         leaf += args.spe_num) {
        const int head = static_cast<int>(leaf % static_cast<size_t>(heads));
        const size_t pixel = leaf / static_cast<size_t>(heads);
        const size_t wide_dims = static_cast<size_t>(dims) & ~static_cast<size_t>(3);
        for (size_t wide = 0; wide < wide_dims; wide += 4) {
            float acc0 = 0.0f;
            float acc1 = 0.0f;
            float acc2 = 0.0f;
            float acc3 = 0.0f;
            for (size_t sample = 0; sample < samples; ++sample) {
                const size_t owner = sample / samples_per_owner;
                if (static_cast<int>(owner % static_cast<size_t>(heads)) != head) {
                    continue;
                }
                const int batch = static_cast<int>(owner / static_cast<size_t>(heads) /
                                                   static_cast<size_t>(queries));
                const int level =
                    static_cast<int>((sample % samples_per_owner) /
                                     static_cast<size_t>(points));
                size_t level_start = 0;
                for (int l = 0; l < level; ++l) {
                    level_start += static_cast<size_t>(args.spatial_shapes[2 * l]) *
                                   static_cast<size_t>(args.spatial_shapes[2 * l + 1]);
                }
                const int height = args.spatial_shapes[2 * level];
                const int width = args.spatial_shapes[2 * level + 1];
                const float x = load_scalar(locations, sample * 2) * width - 0.5f;
                const float y = load_scalar(locations, sample * 2 + 1) * height - 0.5f;
                // Outside the support both the sample and all derivatives are zero.
                if (!(x >= -1.0f && x < width && y >= -1.0f && y < height)) {
                    continue;
                }
                const float x_floor = floorf(x);
                const float y_floor = floorf(y);
                const int x0 = static_cast<int>(x_floor);
                const int y0 = static_cast<int>(y_floor);
                const float tx = x - x_floor;
                const float ty = y - y_floor;
                const float wx[2] = {1.0f - tx, tx};
                const float wy[2] = {1.0f - ty, ty};
                const float aw = load_scalar(weights, sample);
                const size_t pixel_start =
                    static_cast<size_t>(batch) * args.value_len + level_start;
                for (int iy = 0; iy < 2; ++iy) {
                    for (int ix = 0; ix < 2; ++ix) {
                        const int px = x0 + ix;
                        const int py = y0 + iy;
                        if (px < 0 || px >= width || py < 0 || py >= height) {
                            continue;
                        }
                        if (pixel_start + static_cast<size_t>(py) * width + px != pixel) {
                            continue;
                        }
                        acc0 += load_scalar(grad_output, owner * static_cast<size_t>(dims) +
                                                                           static_cast<size_t>(wide + 0)) *
                                               aw * wx[ix] * wy[iy];
                        acc1 += load_scalar(grad_output, owner * static_cast<size_t>(dims) +
                                                                           static_cast<size_t>(wide + 1)) *
                                               aw * wx[ix] * wy[iy];
                        acc2 += load_scalar(grad_output, owner * static_cast<size_t>(dims) +
                                                                           static_cast<size_t>(wide + 2)) *
                                               aw * wx[ix] * wy[iy];
                        acc3 += load_scalar(grad_output, owner * static_cast<size_t>(dims) +
                                                                           static_cast<size_t>(wide + 3)) *
                                               aw * wx[ix] * wy[iy];
                    }
                }
            }
            args.grad_value[leaf * static_cast<size_t>(dims) + wide + 0] = acc0;
            args.grad_value[leaf * static_cast<size_t>(dims) + wide + 1] = acc1;
            args.grad_value[leaf * static_cast<size_t>(dims) + wide + 2] = acc2;
            args.grad_value[leaf * static_cast<size_t>(dims) + wide + 3] = acc3;
        }
        for (size_t dim = wide_dims; dim < static_cast<size_t>(dims); ++dim) {
            float acc = 0.0f;
            for (size_t sample = 0; sample < samples; ++sample) {
                const size_t owner = sample / samples_per_owner;
                if (static_cast<int>(owner % static_cast<size_t>(heads)) != head) {
                    continue;
                }
                const int batch = static_cast<int>(owner / static_cast<size_t>(heads) /
                                                   static_cast<size_t>(queries));
                const int level =
                    static_cast<int>((sample % samples_per_owner) /
                                     static_cast<size_t>(points));
                size_t level_start = 0;
                for (int l = 0; l < level; ++l) {
                    level_start += static_cast<size_t>(args.spatial_shapes[2 * l]) *
                                   static_cast<size_t>(args.spatial_shapes[2 * l + 1]);
                }
                const int height = args.spatial_shapes[2 * level];
                const int width = args.spatial_shapes[2 * level + 1];
                const float x = load_scalar(locations, sample * 2) * width - 0.5f;
                const float y = load_scalar(locations, sample * 2 + 1) * height - 0.5f;
                // Outside the support both the sample and all derivatives are zero.
                if (!(x >= -1.0f && x < width && y >= -1.0f && y < height)) {
                    continue;
                }
                const float x_floor = floorf(x);
                const float y_floor = floorf(y);
                const int x0 = static_cast<int>(x_floor);
                const int y0 = static_cast<int>(y_floor);
                const float tx = x - x_floor;
                const float ty = y - y_floor;
                const float wx[2] = {1.0f - tx, tx};
                const float wy[2] = {1.0f - ty, ty};
                const float aw = load_scalar(weights, sample);
                const size_t pixel_start =
                    static_cast<size_t>(batch) * args.value_len + level_start;
                for (int iy = 0; iy < 2; ++iy) {
                    for (int ix = 0; ix < 2; ++ix) {
                        const int px = x0 + ix;
                        const int py = y0 + iy;
                        if (px < 0 || px >= width || py < 0 || py >= height) {
                            continue;
                        }
                        if (pixel_start + static_cast<size_t>(py) * width + px != pixel) {
                            continue;
                        }
                        acc += load_scalar(grad_output, owner * static_cast<size_t>(dims) +
                                                                           static_cast<size_t>(dim)) *
                                               aw * wx[ix] * wy[iy];
                    }
                }
            }
            args.grad_value[leaf * static_cast<size_t>(dims) + dim] = acc;
        }
    }

    // Stage 2 - one work item per sampling point: grad_locations and
    // grad_weights, unchanged from the original kernel apart from the removal
    // of the grad_value atomics that stage 1 now owns.
    for (size_t sample = static_cast<size_t>(threadIdx); sample < samples;
         sample += args.spe_num) {
        const size_t owner = sample / samples_per_owner;
        const int level = static_cast<int>((sample % samples_per_owner) /
                                           static_cast<size_t>(points));
        const int head = static_cast<int>(owner % static_cast<size_t>(heads));
        const int batch = static_cast<int>(owner / static_cast<size_t>(heads) /
                                           static_cast<size_t>(queries));
        float go[128];
        for (int dim = 0; dim < dims; ++dim) {
            go[dim] = load_scalar(grad_output, owner * static_cast<size_t>(dims) +
                                                 static_cast<size_t>(dim));
        }
        size_t level_start = 0;
        for (int l = 0; l < level; ++l) {
            level_start += static_cast<size_t>(args.spatial_shapes[2 * l]) *
                           static_cast<size_t>(args.spatial_shapes[2 * l + 1]);
        }
        const int height = args.spatial_shapes[2 * level];
        const int width = args.spatial_shapes[2 * level + 1];
        const size_t base =
            (static_cast<size_t>(batch) * args.value_len + level_start) * heads * dims;
        const float x = load_scalar(locations, sample * 2) * width - 0.5f;
        const float y = load_scalar(locations, sample * 2 + 1) * height - 0.5f;
        float grad_x = 0.0f;
        float grad_y = 0.0f;
        float grad_weight = 0.0f;
        // Outside the support both the sample and all derivatives are zero.
        if (x >= -1.0f && x < width && y >= -1.0f && y < height) {
            const float x_floor = floorf(x);
            const float y_floor = floorf(y);
            const int x0 = static_cast<int>(x_floor);
            const int y0 = static_cast<int>(y_floor);
            const float tx = x - x_floor;
            const float ty = y - y_floor;
            const float wx[2] = {1.0f - tx, tx};
            const float wy[2] = {1.0f - ty, ty};
            const float aw = load_scalar(weights, sample);
            size_t index[4];
            bool valid[4];
            for (int iy = 0; iy < 2; ++iy) {
                for (int ix = 0; ix < 2; ++ix) {
                    const int corner = iy * 2 + ix;
                    const int px = x0 + ix;
                    const int py = y0 + iy;
                    valid[corner] = px >= 0 && px < width && py >= 0 && py < height;
                    index[corner] = valid[corner]
                        ? base + ((static_cast<size_t>(py) * width + px) * heads + head) * dims
                        : 0;
                }
            }
            for (int dim = 0; dim < dims; ++dim) {
                float v[4];
                for (int iy = 0; iy < 2; ++iy) {
                    for (int ix = 0; ix < 2; ++ix) {
                        const int corner = iy * 2 + ix;
                        v[corner] = valid[corner]
                            ? load_scalar(value, index[corner] + dim) : 0.0f;
                    }
                }
                const float sampled = v[0] * wx[0] * wy[0] + v[1] * wx[1] * wy[0]
                                    + v[2] * wx[0] * wy[1] + v[3] * wx[1] * wy[1];
                grad_weight += go[dim] * sampled;
                grad_x += go[dim] * aw * ((v[1] - v[0]) * wy[0] + (v[3] - v[2]) * wy[1]);
                grad_y += go[dim] * aw * ((v[2] - v[0]) * wx[0] + (v[3] - v[1]) * wx[1]);
            }
        }
        store_scalar(grad_locations, sample * 2, grad_x * width);
        store_scalar(grad_locations, sample * 2 + 1, grad_y * height);
        store_scalar(grad_weights, sample, grad_weight);
    }
}

}  // namespace

__global__ void teco_slave_ms_deform_attn_backward_fp32_gather(MsDeformAttnBackwardArgs args) {
    bilinear_backward_gather<float>(args);
}
