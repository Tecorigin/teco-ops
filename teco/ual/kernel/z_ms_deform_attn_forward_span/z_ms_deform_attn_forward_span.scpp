#include "ual/kernel/z_ms_deform_attn_forward_span/z_ms_deform_attn_forward_span.h"

#include <climits>
#include <cmath>
#include <cstdint>
#include <sdaa_memcpy.h>

#include "teco_kernel_context.h"

namespace {

__device__ inline float read_as_float(const float *data, size_t index) {
    return data[index];
}

// Native half conversion flushes subnormals on SDAA. Preserve their bits before
// coordinate scaling, which can amplify a tiny input error by the image width.
__device__ inline float read_as_float(const half *data, size_t index) {
    const std::uint16_t bits =
        reinterpret_cast<const std::uint16_t *>(data)[index];
    if ((bits & 0x7c00u) == 0) {
        const float magnitude = static_cast<float>(bits & 0x03ffu) * 0x1p-24f;
        return (bits & 0x8000u) ? -magnitude : magnitude;
    }
    return static_cast<float>(data[index]);
}

// Span-merge specialization of ms_deform_attn_forward (device side only).
//
// The delivered kernel issues one blocking value-record transfer per valid
// bilinear corner.  Inside a level plane value is [pixel, head, dim] with pixel
// stride num_heads*head_dim, so the <=4 corner blocks of one (level, point) lie
// in a contiguous pixel span of at most 2*width pixels: one blocked transfer
// can carry all of them.
//
// The capacity decision is NOT taken in this kernel.  It is bound once per call
// by the host in findMsDeformAttnForwardBranch from the conservative predicate
// 2*value_len*num_heads*head_dim <= 128 (which implies every span fits
// T value_record[128], because width <= value_len for every level), so this
// kernel contains no selector branch and no getenv.  The record is pixel aligned
// (it starts at head 0 of the first pixel), a corner block sits at
// (pixel - start)*num_heads*head_dim + head*head_dim, and the additions still run
// row 0 then row 1, left then right, with the delivered expressions and
// rounding -- the result is bit-identical to the delivered kernel.
//
// This directory sorts after every delivered device TU (asserted by
// verify_arrangement.sh), so adding it does not move any delivered module inside
// the single LTO link unit.
template <typename T>
__device__ void ms_deform_attn_forward_span_kernel(MsDeformAttnForwardArgs args) {
    const int n = args.batch;
    const int s = args.value_len;
    const int m = args.num_heads;
    const int d = args.head_dim;
    const int lq = args.num_queries;
    const int levels = args.num_levels;
    const int points = args.num_points;
    const int64_t *shapes = args.spatial_shapes;
    const T *value = static_cast<const T *>(args.value);
    const T *locations = static_cast<const T *>(args.sampling_locations);
    const T *weights = static_cast<const T *>(args.attention_weights);
    T *output = static_cast<T *>(args.output);

    // One work item owns one (batch, query, head) vector; sampling coordinates
    // and weights are shared by all D lanes.
    const size_t total = static_cast<size_t>(n) * lq * m;
    const size_t per_spe = (total + args.spe_num - 1) / args.spe_num;
    const size_t begin = static_cast<size_t>(threadIdx) * per_spe;
    const size_t end = (begin + per_spe < total) ? begin + per_spe : total;

    T value_record[128] __attribute__((aligned(64)));
    for (size_t flat = begin; flat < end; ++flat) {
        size_t t = flat;
        const int head = static_cast<int>(t % m);
        t /= m;
        const int query = static_cast<int>(t % lq);
        const int batch = static_cast<int>(t / lq);
        float acc[128];
        for (int dim = 0; dim < d; ++dim) acc[dim] = 0.0f;

        int level_start = 0;
        for (int level = 0; level < levels; ++level) {
            const int h = shapes[level * 2];
            const int w = shapes[level * 2 + 1];
            const size_t loc_base =
                (((((static_cast<size_t>(batch) * lq + query) * m + head) * levels + level)
                    * points) * 2);
            const size_t weight_base =
                ((((static_cast<size_t>(batch) * lq + query) * m + head) * levels + level)
                    * points);

            for (int point = 0; point < points; ++point) {
                const float sx = read_as_float(locations, loc_base + point * 2);
                const float sy = read_as_float(locations, loc_base + point * 2 + 1);
                const float x = sx * static_cast<float>(w) - 0.5f;
                const float y = sy * static_cast<float>(h) - 0.5f;
                const float x0f = floorf(x);
                const float y0f = floorf(y);
                const int x0 = static_cast<int>(x0f);
                const int y0 = static_cast<int>(y0f);
                const int x1 = x0 + 1;
                const int y1 = y0 + 1;
                const float wx1 = x - x0f;
                const float wy1 = y - y0f;
                const float wx0 = 1.0f - wx1;
                const float wy0 = 1.0f - wy1;
                const float aw = read_as_float(weights, weight_base + point);

                const size_t value_base =
                    (static_cast<size_t>(batch) * s + level_start) * m * d;
                const int xs[2] = {x0, x1};
                const float wx[2] = {wx0, wx1};
                const float wy[2] = {wy0, wy1};

                const bool vx0 = (x0 >= 0 && x0 < w);
                const bool vx1 = (x1 >= 0 && x1 < w);
                const bool vy0 = (y0 >= 0 && y0 < h);
                const bool vy1 = (y1 >= 0 && y1 < h);
                int lo0 = INT_MAX, hi0 = INT_MIN, lo1 = INT_MAX, hi1 = INT_MIN;
                if (vy0) {
                    if (vx0) { lo0 = x0; hi0 = x0; }
                    if (vx1) {
                        if (x1 < lo0) lo0 = x1;
                        if (x1 > hi0) hi0 = x1;
                    }
                }
                if (vy1) {
                    if (vx0) { lo1 = x0; hi1 = x0; }
                    if (vx1) {
                        if (x1 < lo1) lo1 = x1;
                        if (x1 > hi1) hi1 = x1;
                    }
                }
                if (lo0 != INT_MAX || lo1 != INT_MAX) {
                    const int start_pixel =
                        (lo0 != INT_MAX) ? (y0 * w + lo0) : (y1 * w + lo1);
                    const int last_pixel =
                        (hi1 != INT_MIN) ? (y1 * w + hi1) : (y0 * w + hi0);
                    const int span = last_pixel - start_pixel + 1;
                    ::memcpy(value_record,
                             value + value_base + static_cast<size_t>(start_pixel) * m * d,
                             static_cast<size_t>(span) * m * d * sizeof(T));
                    if (vy0) {
                        for (int ix = 0; ix < 2; ++ix) {
                            if (!(ix == 0 ? vx0 : vx1)) continue;
                            const size_t off =
                                static_cast<size_t>(y0 * w + xs[ix] - start_pixel) * m * d +
                                static_cast<size_t>(head) * d;
                            const float factor = wx[ix] * wy[0] * aw;
                            for (int dim = 0; dim < d; ++dim) {
                                acc[dim] += read_as_float(value_record, off + dim) * factor;
                            }
                        }
                    }
                    if (vy1) {
                        for (int ix = 0; ix < 2; ++ix) {
                            if (!(ix == 0 ? vx0 : vx1)) continue;
                            const size_t off =
                                static_cast<size_t>(y1 * w + xs[ix] - start_pixel) * m * d +
                                static_cast<size_t>(head) * d;
                            const float factor = wx[ix] * wy[1] * aw;
                            for (int dim = 0; dim < d; ++dim) {
                                acc[dim] += read_as_float(value_record, off + dim) * factor;
                            }
                        }
                    }
                }
            }
            level_start += h * w;
        }
        const size_t output_base = flat * d;
        for (int dim = 0; dim < d; ++dim) {
            output[output_base + dim] = static_cast<T>(acc[dim]);
        }
    }
}

}  // namespace

__global__ void teco_slave_ms_deform_attn_forward_span_fp32(MsDeformAttnForwardArgs args) {
    ms_deform_attn_forward_span_kernel<float>(args);
}

__global__ void teco_slave_ms_deform_attn_forward_span_fp16(MsDeformAttnForwardArgs args) {
    ms_deform_attn_forward_span_kernel<half>(args);
}
