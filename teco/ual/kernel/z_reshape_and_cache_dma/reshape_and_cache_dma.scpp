// reshape_and_cache: 将 key/value 按 slot_mapping 写入 paged KV cache
//
// 输入: key   [num_tokens, num_kv_heads, head_size] (HBM)
//       value [num_tokens, num_kv_heads, head_size] (HBM)
// 输出: key_cache   [num_blocks, num_kv_heads, block_size, head_size]
//       value_cache [num_blocks, num_kv_heads, block_size, head_size]
//
// DMA 实现（本 TU 专有；原阻塞式 memcpy 版本仍在
// teco/ual/kernel/reshape_and_cache/reshape_and_cache_fp16.scpp 作为兜底）:
//   - 一个 token 的整行 [H, D] 在 key/value 里本来就是连续的
//     (key_stride == H * head_bytes)，用**一次连续 DMA** 取进 SPM；
//   - 再用**一次带 stride 的 DMA** 写出 H 段（每段 head_bytes，段间 gap =
//     head_stride - head_bytes），reshape 完全由 DMA 段描述符完成。
//   - 通用 memcpy() 的 Global→Global 方向在 SDAA 上是**软件拷贝**
//     (sdaa_memcpy.h: MemcpyGlobalToGlobal = 7 RESERVED ⇒ 无 DMA 引擎)，
//     官方 case_0 实测把内核钉在 31.5 GB/s（同卡拷贝地板 224–268 GB/s 的 12%）。
//   - MemoryStride 是"每段之后前进的 gap"，不是绝对 stride（见 flash_attention
//     memcpy_stride 的三处调用，如 {0, (local_head_num - 1) * token_size}）。
//
// 选择本 kernel 还是兜底 kernel 由 findReshapeAndCacheBranch 在 dispatch 期
// 一次性决定（64 B 对齐守卫），热路径内零 if-else、零 getenv。

#include <simd.h>
#include <slave.h>

#include "ual/com/rt.h"
#include "ual/kernel/z_reshape_and_cache_dma/reshape_and_cache_dma.h"

using namespace tecoops::ual::args;  // NOLINT
using namespace sdaa;  // NOLINT

__global__ void teco_slave_reshape_and_cache_fp16_dma(ReshapeAndCacheArgs args) {
    const int tid = threadIdx;
    constexpr int CORE_NUM = 32;

    int H = args.num_kv_heads;
    int D = args.size_per_head;
    int T = args.num_tokens;
    int block_size = args.block_size;

    int block_stride  = args.block_stride;
    int head_stride   = args.head_stride;
    int entry_stride  = args.entry_stride;
    int key_stride    = args.key_stride;
    int value_stride  = args.value_stride;

    const half *key   = (const half *)(args.key);
    const half *value = (const half *)(args.value);
    const int64_t *slot_mapping = args.slot_mapping;
    char *key_cache   = (char *)(args.key_cache);
    char *value_cache = (char *)(args.value_cache);

    const int head_bytes = D * (int)sizeof(half);
    const int row_bytes  = H * head_bytes;
    const size_t put_gap = (size_t)(head_stride - head_bytes);

    // [c38-MCP-RACP4+] 542a2a1 gave both the LOAD and the PUT two iterations of slack
    // (4 sets, look-ahead 2).  The exposed remainder is still a per-token stall on the
    // small-H cases, so widen the window: 8 staging sets with a look-ahead of 4.
    // Set index of iteration j is j & (STAGE-1); the set refilled at iteration it is
    // (it+LOOKAHEAD)&(STAGE-1), which was last *read* by iteration it-(STAGE-LOOKAHEAD),
    // so waiting on that set's put there gives the put 4 iterations of flight and the
    // load 4.  Bytes, destinations and per-token order are unchanged.
    constexpr int STAGE     = 8;   // power of two
    constexpr int LOOKAHEAD = 4;
    char *spm_key   = (char *)rt_spm_malloc(STAGE * (size_t)row_bytes);
    char *spm_value = (char *)rt_spm_malloc(STAGE * (size_t)row_bytes);
    char *spmk[STAGE];
    char *spmv[STAGE];
    for (int s = 0; s < STAGE; ++s) {
        spmk[s] = spm_key   + (size_t)s * row_bytes;
        spmv[s] = spm_value + (size_t)s * row_bytes;
    }

    MemcpyHandle get_key[STAGE], get_value[STAGE], put_key[STAGE], put_value[STAGE];
    // Prime sets 0..LOOKAHEAD-1; the loop below fills the rest (cold waits are idle-safe).
    for (int i = 0; i < LOOKAHEAD; ++i) {
        const int t0 = tid + i * CORE_NUM;
        if (t0 < T) {
            const half *src_key0   = key   + (size_t)t0 * key_stride / sizeof(half);
            const half *src_value0 = value + (size_t)t0 * value_stride / sizeof(half);
            memcpy_async(spmk[i], src_key0, row_bytes, MemcpyGlobalToSpm, get_key[i]);
            memcpy_async(spmv[i], src_value0, row_bytes, MemcpyGlobalToSpm, get_value[i]);
        }
    }

    int it = 0;
    for (int t = tid; t < T; t += CORE_NUM, ++it) {
        const int p = it & (STAGE - 1);                    // set holding this token
        const int r = (it + LOOKAHEAD) & (STAGE - 1);      // set refilled right below

        memcpy_wait(get_key[p]);
        memcpy_wait(get_value[p]);

        int64_t slot = slot_mapping[t];
        if (slot >= 0) {
            int block_id  = slot / block_size;
            int block_off = slot % block_size;

            char *cache_key_base = (char *)key_cache
                + block_id * block_stride + block_off * entry_stride;
            char *cache_value_base = (char *)value_cache
                + block_id * block_stride + block_off * entry_stride;

            memcpy_async(cache_key_base, spmk[p], row_bytes, head_bytes,
                         {put_gap, 0}, MemcpySpmToGlobal, put_key[p]);
            memcpy_async(cache_value_base, spmv[p], row_bytes, head_bytes,
                         {put_gap, 0}, MemcpySpmToGlobal, put_value[p]);
        }

        // Drain the put that last read set r (issued 4 iterations ago) and only then
        // refill set r: this is exactly the wait that used to sit on the token path.
        memcpy_wait(put_key[r]);
        memcpy_wait(put_value[r]);

        const int tn = t + LOOKAHEAD * CORE_NUM;
        if (tn < T) {
            const half *src_key_n   = key   + (size_t)tn * key_stride / sizeof(half);
            const half *src_value_n = value + (size_t)tn * value_stride / sizeof(half);
            memcpy_async(spmk[r], src_key_n, row_bytes, MemcpyGlobalToSpm, get_key[r]);
            memcpy_async(spmv[r], src_value_n, row_bytes, MemcpyGlobalToSpm, get_value[r]);
        }
    }

    // Drain every outstanding store before the staging carve is released.
    for (int s = 0; s < STAGE; ++s) {
        memcpy_wait(put_key[s]);
        memcpy_wait(put_value[s]);
    }
    rt_spm_free(spm_key);
    rt_spm_free(spm_value);
}
